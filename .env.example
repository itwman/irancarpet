# کپی این فایل به .env و پر کردن مقادیر
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=irancarpet.net,www.irancarpet.net,127.0.0.1
SITE_URL=https://irancarpet.net

# دیتابیس جدید جنگو (MySQL/MariaDB)
DATABASE_URL=mysql://ic_django:PASSWORD@127.0.0.1:3306/ic_django

# دیتابیس وردپرس فعلی — فقط برای ایمپورت (فقط خواندنی)
WP_DATABASE_URL=mysql://ic_reader:PASSWORD@127.0.0.1:3306/irancarpet_shop

# پوشهٔ uploads وردپرس — تصاویر از همین‌جا با همان آدرس قبلی سرو می‌شوند
MEDIA_ROOT=/var/www/irancarpet/public_html/wp-content/uploads
STATIC_ROOT=/var/www/irancarpet-django/staticfiles

# درگاه‌های پرداخت (خالی = غیرفعال)
SEP_TERMINAL_ID=
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=False
# درگاه آزمایشی؛ روی سایت اصلی حتماً False
PAYMENT_FAKE=False

# پیامک sms.ir (قالب تأیید با متغیر CODE)
SMSIR_API_KEY=
SMSIR_OTP_TEMPLATE_ID=
# اختیاری: پیامک پرداخت موفق به مشتری (متغیرهای ORDER و AMOUNT) و به مدیر (ORDER، NAME، AMOUNT)
SMSIR_ORDER_TEMPLATE_ID=
SMSIR_ADMIN_TEMPLATE_ID=
