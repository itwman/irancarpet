# /etc/systemd/system/irancarpet.service
[Unit]
Description=IranCarpet Django (gunicorn)
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/irancarpet-django
EnvironmentFile=/var/www/irancarpet-django/.env
ExecStart=/var/www/irancarpet-django/venv/bin/gunicorn config.wsgi:application \
    --bind unix:/run/irancarpet/gunicorn.sock --workers 3 --timeout 60 \
    --access-logfile - --error-logfile -
RuntimeDirectory=irancarpet
Restart=always

[Install]
WantedBy=multi-user.target
